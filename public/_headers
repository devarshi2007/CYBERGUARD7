/*
  Content-Security-Policy: default-src 'self' https: 'unsafe-inline' 'unsafe-eval'; script-src 'self' https: 'unsafe-inline' 'unsafe-eval' esm.run gstatic.com cdnjs.cloudflare.com; style-src 'self' https: 'unsafe-inline' fonts.googleapis.com cdnjs.cloudflare.com; font-src 'self' https: data: fonts.gstatic.com cdnfonts.com; img-src 'self' https: data:; connect-src 'self' https: wss:; worker-src 'self' blob:
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/*.js
  Content-Type: application/javascript; charset=utf-8

/*.css
  Content-Type: text/css; charset=utf-8

/*.json
  Content-Type: application/json; charset=utf-8

/*.svg
  Content-Type: image/svg+xml; charset=utf-8

/*.html
  Content-Type: text/html; charset=utf-8
